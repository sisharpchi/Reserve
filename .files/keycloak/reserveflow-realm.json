{
  "realm": "reserveflow",
  "enabled": true,
  "displayName": "ReserveFlow",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "SystemAdmin",
        "description": "Platform administrator"
      },
      {
        "name": "TenantAdmin",
        "description": "Tenant administrator"
      },
      {
        "name": "Staff",
        "description": "Staff user"
      },
      {
        "name": "Customer",
        "description": "Customer user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "reserveflow-web",
      "name": "ReserveFlow Angular SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ]
    },
    {
      "clientId": "reserveflow-api",
      "name": "ReserveFlow API",
      "enabled": true,
      "bearerOnly": true
    }
  ],
  "users": [
    {
