{
  "realm": "reserveflow",
  "enabled": true,
  "displayName": "ReserveFlow",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "platform-admin",
        "description": "Platform administrator"
      },
      {
        "name": "tenant-admin",
        "description": "Tenant administrator"
      },
      {
        "name": "staff",
        "description": "Staff user"
      },
      {
        "name": "customer",
        "description": "Customer user"
      }
    ]
  },
  "clients": [
    {
      "clientId": "reserveflow-web",
      "name": "ReserveFlow Angular SPA",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "http://localhost:4200/*",
        "http://127.0.0.1:4200/*"
      ],
      "webOrigins": [
        "http://localhost:4200",
        "http://127.0.0.1:4200"
      ]
    },
    {
      "clientId": "reserveflow-api",
      "name": "ReserveFlow API",
      "enabled": true,
      "bearerOnly": true
    },
    {
      "clientId": "reserveflow-admin",
      "name": "ReserveFlow Backend Admin Client",
      "enabled": true,
      "publicClient": false,
      "secret": "reserveflow-admin-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountClientRoles": {
        "realm-management": [
          "manage-users",
          "query-users",
          "view-realm",
          "view-users"
        ]
      }
    }
  ],
  "users": [
    {
      "username": "platform.admin@example.com",
      "email": "platform.admin@example.com",
      "firstName": "Platform",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "platform-admin"
      ]
    },
    {
      "username": "tenant.admin@example.com",
      "email": "tenant.admin@example.com",
      "firstName": "Tenant",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ],
      "realmRoles": [
        "tenant-admin"
      ]
    }
  ]
}
